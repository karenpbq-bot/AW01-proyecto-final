							"// Dentro de la pestaña Tests de \"Obtener Token JWT\"\r",
							"\r",
							"pm.test(\"Guarda el token de acceso JWT\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    var token = jsonData.access; \r",
							"    \r",
							"    // CRUCIAL: Solo guardar en pm.environment.set\r",
							"    pm.environment.set(\"jwt_token\", token); \r",
							"     \r",
