			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"packages": {},
						"requests": {},
						"exec": [
							"// Script de Pre-request de la CARPETA: Inyecta el Token JWT\r",
							"\r",
							"// 1. Obtener la variable de ambiente (donde el login guardó el token)\r",
							"const token = pm.environment.get(\"jwt_token\");\r",
							"\r",
							"if (token) {\r",
							"    // 2. Establecer el Header de Autorización para TODAS las peticiones en esta carpeta\r",
							"    pm.request.headers.add({\r",
							"        key: 'Authorization',\r",
							"        value: `Bearer ${token}`\r",
							"    });\r",
							"} else {\r",
							"    // Si el token no está, Newman reportará un error en la consola\r",
							"    console.log(\"Error: jwt_token no encontrado. Asegúrese de ejecutar la petición de Login.\");\r",
							"}"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"packages": {},
						"requests": {},
						"exec": [
							""
						]
					}
				}
			]
		},
		{
			"name": "Obtener Token JWT",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Script que se ejecuta en la fase Post-response\r",
							"\r",
							"// 1. Verifica que la respuesta tenga el código de éxito (200 OK)\r",
							"pm.test(\"Status code es 200 OK\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// 2. Guarda el Token de Acceso en la variable de colección {{jwt_token}}\r",
							"pm.test(\"Guarda el token de acceso JWT y el ID de usuario\", function () {\r",
							"    // Parsea el cuerpo de la respuesta JSON\r",
							"    var jsonData = pm.response.json();\r",
							"    \r",
							"    // Extrae el valor del token desde la clave 'access'\r",
							"    var token = jsonData.access; \r",
							"    \r",
							"    // ------------------------------------------------------------------\r",
							"    // ¡CORRECCIÓN CLAVE! Usamos pm.collectionVariables.set para que el token persista\r",
							"    pm.collectionVariables.set(\"jwt_token\", token); \r",
							"    \r",
							"    // Opcional: Guarda el ID de usuario si lo necesitas para otras pruebas\r",
							"    // pm.collectionVariables.set(\"user_id\", jsonData.user_id); \r",
							"    \r",
							"    // Afirma que el token existe y se guardó\r",
							"    pm.expect(token).to.be.a('string');\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
