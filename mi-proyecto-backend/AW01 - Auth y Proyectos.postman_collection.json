							"listen": "test",
							"script": {
								"exec": [
									"// Petición: Crear nuevo proyecto (Pestaña Tests)\r",
									"\r",
									"// 1. Verificación básica del Status Code\r",
									"pm.test(\"Status code es 201 Created\", function () {\r",
									"    pm.response.to.have.status(201);\r",
									"});\r",
									"\r",
									"// 2. Bloque CRÍTICO para guardar la variable 'proyecto_id'\r",
									"var jsonData = pm.response.json();\r",
									"const id_key = 'id'; // CLAVE CORRECTA SEGÚN TU API\r",
									"\r",
									"// Si la respuesta tiene una propiedad 'id', la guardamos\r",
									"if (jsonData && jsonData[id_key]) {\r",
									"    // Guardar el ID en la variable Global para que las siguientes peticiones lo lean\r",
									"    pm.environment.set(\"proyecto_id\", jsonData[id_key]);\r",
									"    \r",
									"    // Test para verificar que el ID se guardó (este test fallaba antes)\r",
									"    pm.test(\"Guarda el ID del proyecto creado\", function () {\r",
									"        pm.expect(pm.globals.get(\"proyecto_id\")).to.be.ok;\r",
									"    });\r",
									"} else {\r",
									"    // Si la clave 'id' no está (lo cual no debería pasar ahora), forzamos el fallo\r",
									"    pm.test(\"ERROR: No se encontró la clave '\" + id_key + \"' en la respuesta JSON\", function () {\r",
									"        pm.expect(jsonData[id_key]).to.be.ok; \r",
									"    });\r",
									"}"
								],
