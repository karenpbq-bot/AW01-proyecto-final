	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"// Este script se ejecuta ANTES de cada solicitud en la colección.\r",
					"// Inyecta el token en el encabezado si existe a nivel GLOBAL,\r",
					"// y omite la inyección para el Login (que no lo necesita).\r",
					"\r",
					"if (pm.info.requestName !== 'Obtener Token JWT') {\r",
					"    \r",
					"    // Obtener el token de la variable GLOBAL\r",
					"    const token = pm.globals.get(\"jwt_token\");\r",
					"\r",
					"    if (token) {\r",
					"        pm.request.headers.add({\r",
					"            key: 'Authorization',\r",
					"            value: `Bearer ${token}`\r",
					"        });\r",
					"    }\r",
					"}"
				]
			}
		},
